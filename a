local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local localPlayer = Players.LocalPlayer

-- Locate the network bridge to talk to the server
local changeAvatarEvent = ReplicatedStorage:WaitForChild("ChangeAvatarEvent")

-- Function to handle local on-screen notifications
local function notify(message)
	pcall(function()
		game:GetService("StarterGui"):SetCore("SendNotification", {
			Title = "Avatar Loader",
			Text = message,
			Duration = 3
		})
	end)
end

-- GUI Setup
local function createGui()
	local gui = Instance.new("ScreenGui")
	gui.Name = "AvatarLoaderGui"
	gui.ResetOnSpawn = false
	
	-- Routes safely to player screen without security errors
	local playerGui = localPlayer:WaitForChild("PlayerGui")
	gui.Parent = playerGui

	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(0, 250, 0, 110)
	frame.Position = UDim2.new(0.5, -125, 0.5, -55)
	frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	frame.Active = true
	frame.Parent = gui

	local corner = Instance.new("UICorner")
	corner.Parent = frame

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, 30)
	title.BackgroundTransparency = 1
	title.Text = "Avatar Copier"
	title.TextColor3 = Color3.fromRGB(255, 255, 255)
	title.Font = Enum.Font.GothamBold
	title.TextSize = 16
	title.Parent = frame

	local input = Instance.new("TextBox")
	input.Size = UDim2.new(0, 200, 0, 30)
	input.Position = UDim2.new(0.5, -100, 0, 35)
	input.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	input.Text = ""
	input.PlaceholderText = "Target UserID"
	input.TextColor3 = Color3.fromRGB(255, 255, 255)
	input.Parent = frame

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, 200, 0, 30)
	btn.Position = UDim2.new(0.5, -100, 0, 70)
	btn.BackgroundColor3 = Color3.fromRGB(0, 150, 50)
	btn.Text = "Apply Outfit"
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Font = Enum.Font.GothamBold
	btn.Parent = frame
	
	-- When clicked, verify input format and signal the server
	btn.MouseButton1Click:Connect(function()
		local targetId = tonumber(input.Text)
		if targetId then
			notify("Sending request to server...")
			changeAvatarEvent:FireServer(targetId)
		else
			notify("Please enter a valid numeric ID.")
		end
	end)
end

createGui()
